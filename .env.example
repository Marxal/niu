# Copy this file to `.env` and fill in the two values from your Supabase project
# (Project Settings -> API). Then restart `npm run dev`.
#
# Both values are compiled into the public JavaScript bundle. That is expected:
# the project URL and the *anon* key are designed to be public, and Row Level
# Security in the database is what actually protects the data.
#
# NEVER put the `service_role` / secret key here. It bypasses every RLS policy.
# The app refuses to start if it detects one (see src/lib/config.ts).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The OAuth client id from Google Cloud Console -> APIs & Services -> Credentials.
# It is the same "Web application" client Supabase's Google sign-in already uses.
# Leave it empty and the calendar still works — it just keeps its events to
# itself instead of pushing them to Google.
#
# Two things must be set on that client for the push to work:
#   * Authorised JavaScript origins must include https://marxal.github.io
#   * The OAuth consent screen must list the scope
#     https://www.googleapis.com/auth/calendar.app.created
VITE_GOOGLE_CLIENT_ID=
